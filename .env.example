# Firebase Web App configuration.
# These NEXT_PUBLIC_* values are client configuration identifiers, not service-account secrets.
# Copy this file to .env.local for local development and add the same keys in Vercel Project Settings.

NEXT_PUBLIC_FIREBASE_API_KEY=your_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_app_id

# Module C AI — server-only. Never prefix Gemini secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=
GEMINI_FILE_SEARCH_STORE=
AI_DAILY_REQUEST_LIMIT=200
AI_PER_USER_WINDOW_LIMIT=10
AI_MAX_TEXT_CHARS=24000
AI_MAX_DOCX_BYTES=5242880

# Root server runtime uses the same keyless Vercel OIDC/WIF pattern as ACC.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
